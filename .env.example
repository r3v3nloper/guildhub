# Public URL. Read by Auth.js and used by the app for absolute URLs.
AUTH_URL=https://guildhub.licktherainbow.de
# openssl rand -base64 32
AUTH_SECRET=
# Required behind SWAG, so the callback URL is built from the forwarded headers.
AUTH_TRUST_HOST=true
# Discord application (https://discord.com/developers/applications),
# redirect URL: AUTH_URL/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Discord user ID of the owner (Discord: Developer Mode on, right-click user, "Copy User ID").
OWNER_DISCORD_ID=
# Comma-separated Discord user IDs of the other guild members.
ALLOWED_DISCORD_IDS=

# Inside the container the database lives in the named volume.
DATABASE_PATH=/data/guildhub.db
# Only used on first start, afterwards editable in the admin area.
GUILD_NAME=
DEFAULT_TIMEZONE=Europe/Berlin

# docker-compose only: name of the Docker network the SWAG container is attached to.
SWAG_NETWORK=ltr-net

# Phase 5:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:...
