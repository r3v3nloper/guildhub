{
  "name": "guildhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "packs:validate": "tsx scripts/packs-validate.ts",
    "theme": "node scripts/build-theme.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  },
  "engines": {
    "node": ">=22"
  }
